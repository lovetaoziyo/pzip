              <desktop4:Verb Id="PZipExtractHere" Clsid="A1F2E3D4-C5B6-4A78-9B0C-1D2E3F4A5B6C" />
              <desktop4:Verb Id="PZipExtractTo" Clsid="B2A3C4D5-E6F7-4A88-9A1B-2C3D4E5F6A7B" />
